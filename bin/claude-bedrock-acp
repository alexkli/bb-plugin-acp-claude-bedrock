#!/usr/bin/env bash
# bb ACP agent entry point: Claude Code on AWS Bedrock, served over ACP by
# @agentclientprotocol/claude-agent-acp, behind claude-bedrock-acp-proxy.mjs
# (next to this script). The bb plugin registers it as the provider
# acp-claude-bedrock (provider.ts) and writes its settings (region, key file,
# ...) as the variables below to the file CLAUDE_BEDROCK_ENV_FILE names, which
# this script reads first.
#
# stdout is the ACP channel: never print anything to it.
#
# Configuration (environment, all optional):
#   CLAUDE_BEDROCK_ENV_FILE   Shell file of `export NAME='value'` lines with the
#                             plugin's settings; read first, so its values win.
#   CLAUDE_BEDROCK_KEY_FILE   File with the Bedrock API key (the plugin names
#                             bb's own file for its secret API key setting).
#   AWS_BEARER_TOKEN_BEDROCK  Bedrock API key. If unset, read from the key file,
#                             else from the macOS
#                             keychain (service CLAUDE_BEDROCK_KEYCHAIN_SERVICE,
#                             default "claude-bedrock-token", account $USER);
#                             without either, Claude Code uses the normal AWS
#                             credential chain (AWS_PROFILE, SSO, ...).
#   AWS_REGION                Bedrock region (default us-east-1).
#   CLAUDE_AGENT_ACP          Command of the ACP adapter (default: the adapter
#                             bundled with the plugin, else claude-agent-acp on
#                             PATH; nothing is downloaded).
#   CLAUDE_CODE_EXECUTABLE    Claude Code binary the adapter runs (default: claude
#                             on PATH, else the adapter's bundled one).
#   CLAUDE_BEDROCK_PRICE_FACTOR, CLAUDE_BEDROCK_ACP_HIDE_OPTIONS,
#   CLAUDE_BEDROCK_SANDBOX: see the proxy.
#
# Arguments: bb adds --bb-permission-mode=<full|accept-edits> (the provider's
# permissionCli); they go to the proxy, which takes that one off.
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# bb starts agents with a minimal PATH; add the usual install locations
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

# the plugin's settings (provider.ts, envFileContent)
if [[ -n "${CLAUDE_BEDROCK_ENV_FILE:-}" && -r "$CLAUDE_BEDROCK_ENV_FILE" ]]; then
    # shellcheck source=/dev/null
    source "$CLAUDE_BEDROCK_ENV_FILE"
fi

credentials="aws credential chain${AWS_PROFILE:+ (profile $AWS_PROFILE)}"
if [[ -n "${AWS_BEARER_TOKEN_BEDROCK:-}" ]]; then
    credentials="api key from environment"
elif [[ -n "${CLAUDE_BEDROCK_KEY_FILE:-}" && -r "$CLAUDE_BEDROCK_KEY_FILE" ]]; then
    AWS_BEARER_TOKEN_BEDROCK="$(tr -d '[:space:]' < "$CLAUDE_BEDROCK_KEY_FILE")"
    export AWS_BEARER_TOKEN_BEDROCK
    credentials="api key from plugin settings"
elif command -v security >/dev/null; then
    token=$(security find-generic-password -a "$USER" -s "${CLAUDE_BEDROCK_KEYCHAIN_SERVICE:-claude-bedrock-token}" -w 2>/dev/null || true)
    if [[ -n "$token" ]]; then
        export AWS_BEARER_TOKEN_BEDROCK="$token"
        credentials="api key from keychain"
    fi
fi
export CLAUDE_CODE_USE_BEDROCK=1
export AWS_REGION="${AWS_REGION:-us-east-1}"

if [[ -z "${CLAUDE_CODE_EXECUTABLE:-}" ]] && command -v claude >/dev/null; then
    CLAUDE_CODE_EXECUTABLE="$(command -v claude)"
    export CLAUDE_CODE_EXECUTABLE
fi

if [[ -n "${CLAUDE_AGENT_ACP:-}" ]]; then
    read -r -a adapter <<<"$CLAUDE_AGENT_ACP"
elif [[ -f "$here/../node_modules/@agentclientprotocol/claude-agent-acp/dist/index.js" ]]; then
    # the adapter bundled with this plugin (a dependency in package.json)
    adapter=(node "$here/../node_modules/@agentclientprotocol/claude-agent-acp/dist/index.js")
elif command -v claude-agent-acp >/dev/null; then
    adapter=(claude-agent-acp)
else
    echo "claude-bedrock-acp: the ACP adapter was not found: run npm install in the plugin folder, or set the ACP adapter command setting." >&2
    exit 1
fi

# one line per launch (never the key itself), for troubleshooting
state="${XDG_STATE_HOME:-$HOME/.local/state}/claude-bedrock"
mkdir -p "$state" 2>/dev/null &&
    printf '%s region=%s credentials=%s adapter=%s\n' "$(date -u +%FT%TZ)" "$AWS_REGION" "$credentials" "${adapter[0]}" >>"$state/launcher.log" 2>/dev/null || true

if ! command -v node >/dev/null; then
    echo "claude-bedrock-acp: Node.js (node) was not found on PATH." >&2
    exit 1
fi
exec node "$here/claude-bedrock-acp-proxy.mjs" "${adapter[@]}" "$@"
